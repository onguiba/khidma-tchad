# Configuration KHIDMA Tchad - Environnement de production

# Port du serveur backend
PORT=3001

# Secret JWT pour l'authentification (CHANGEZ EN PRODUCTION !)
JWT_SECRET=khidma_tchad_jwt_secret_2025_changez_moi_en_production

# Environnement Node.js
NODE_ENV=production

# URL de l'API (pour le frontend)
# En local: http://localhost:3001/api
# En production: https://votre-domaine.com/api
API_URL=http://localhost:3001/api

# Configuration CORS (domaines autorisés, séparés par des virgules)
CORS_ORIGIN=http://localhost:3000,http://localhost:80,https://votre-domaine.com

# Base de données SQLite
DATABASE_PATH=./khidma_tchad.db

# Logs
LOG_LEVEL=info
